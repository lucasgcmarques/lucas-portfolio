# Token da integração interna do Notion (https://www.notion.so/profile/integrations).
# A integração precisa ter acesso à página "VJ Olho Negro" (que contém o database VJ Projects).
NOTION_TOKEN=

# ID do database "VJ Projects" (o trecho de 32 caracteres da URL do database).
NOTION_DATABASE_ID=9fa47e7d33e34a2b8664977942a65bf7

# Opcional: página do Notion cujo conteúdo substitui a biografia na página Sobre.
NOTION_ABOUT_PAGE_ID=

# Opcional: vídeo (.mp4/.webm) que passa por dentro das letras na Home.
# Se ficar vazio, o site usa a capa (vídeo ou imagem) do primeiro projeto em destaque.
HERO_VIDEO_URL=

# Segredo para atualizar o site na hora: /api/revalidate?secret=SEU_SEGREDO
REVALIDATE_SECRET=

# URL pública do site (usada em metadados e no sitemap). Na Vercel é preenchida sozinha.
NEXT_PUBLIC_SITE_URL=
